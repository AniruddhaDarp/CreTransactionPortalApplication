        <mxCell id="rulenotes" value="EventBridge rules (content-based filter patterns)&#10;&#10;Audit          →  every event&#10;Notifications  →  message.posted[mentions], handshake.*,&#10;                        docrequest.*, member.invited, deal.status_changed&#10;Chat           →  member.*      (membership projection)&#10;Documents       →  member.*, handshake.approved&#10;Deals          →  document.archived   (closes delete saga)" style="text;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontFamily=Courier New;" vertex="1" parent="1">
